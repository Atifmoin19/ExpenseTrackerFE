# Copy to .env.local and fill in. All VITE_* values are compiled into the
# public JS bundle, so never put a secret here.

# Backend origin, no trailing slash (the FE appends /api/v1/...).
VITE_BASE_URL=http://localhost:8000

# development | production (controls Redux devtools and persist key).
VITE_APP_ENV=development

# Google Identity Services OAuth client id. Leave blank to hide Google sign-in.
VITE_GOOGLE_CLIENT_ID=

# Must exactly match the backend VAPID_PUBLIC_KEY. Leave blank to disable push.
VITE_VAPID_PUBLIC_KEY=

# Show the "Try the demo" button on the sign-in screen. The backend must also
# have DEMO_MODE_ENABLED=true, otherwise the endpoint returns 404.
VITE_DEMO_ENABLED=false
